---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import FormattedDateArray from '../../components/FormattedDateArray.astro';
import { SITE_TITLE } from '../../consts';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import { languages, type Lang } from '../../i18n/ui';

export function getStaticPaths() {
	return Object.keys(languages).map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const isFrench = lang === 'fr';
const locale = isFrench ? 'fr-FR' : 'en-US';
const siteBase = import.meta.env.BASE_URL.replace(/\/$/, '');
const posts = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const labels = isFrench ? {
	title: '📊 Statut des articles',
	description: 'Tableau de suivi des articles français et anglais.',
	image: 'Image',
	translations: 'Traductions',
	postTitle: 'Titre',
	status: 'Statut',
	created: 'Date de création',
	published: 'Date de publication',
	updated: 'Date de mise à jour',
	publishedStatus: 'Publié',
	upcomingStatus: 'À venir',
	draftStatus: 'Brouillon',
	missingFrench: 'Traduction française manquante',
	missingEnglish: 'Traduction anglaise manquante',
	openFrench: 'Ouvrir la version française de',
	openEnglish: 'Ouvrir la version anglaise de',
} : {
	title: '📊 Post status',
	description: 'Tracking dashboard for French and English posts.',
	image: 'Image',
	translations: 'Translations',
	postTitle: 'Title',
	status: 'Status',
	created: 'Creation date',
	published: 'Publication date',
	updated: 'Last updated',
	publishedStatus: 'Published',
	upcomingStatus: 'Upcoming',
	draftStatus: 'Draft',
	missingFrench: 'French translation missing',
	missingEnglish: 'English translation missing',
	openFrench: 'Open the French version of',
	openEnglish: 'Open the English version of',
};

type BlogPost = (typeof posts)[number];
type ArticleGroup = { slug: string; fr?: BlogPost; en?: BlogPost };
const articleMap = new Map<string, ArticleGroup>();

for (const post of posts) {
	const [postLang, ...slugParts] = post.id.split('/');
	const slug = slugParts.join('/');
	const article = articleMap.get(slug) ?? { slug };
	if (postLang === 'fr' || postLang === 'en') article[postLang] = post;
	articleMap.set(slug, article);
}

const articles = [...articleMap.values()].sort((a, b) => {
	const aPost = a.fr ?? a.en!;
	const bPost = b.fr ?? b.en!;
	return bPost.data.pubDate.valueOf() - aPost.data.pubDate.valueOf();
});

const postUrl = (postLang: 'fr' | 'en', slug: string) =>
	`${siteBase}/${postLang}/blog/${slug}/`;

const getStatus = (post: BlogPost) => {
	if (!post.data.isPublished) return labels.draftStatus;
	return post.data.pubDate.valueOf() > Date.now()
		? labels.upcomingStatus
		: labels.publishedStatus;
};
---

<!doctype html>
<html lang={lang}>
	<head>
		<BaseHead title={`${labels.title} · ${SITE_TITLE}`} description={labels.description} locale={isFrench ? 'fr_FR' : 'en_US'} />
	</head>
	<body>
		<Header />
		<main class="status-page">
			<h1>{labels.title}</h1>
			<table>
				<thead>
					<tr>
						<th>{labels.image}</th>
						<th>{labels.translations}</th>
						<th>{labels.postTitle}</th>
						<th>{labels.status}</th>
						<th>{labels.created}</th>
						<th>{labels.published}</th>
						<th>{labels.updated}</th>
					</tr>
				</thead>
				<tbody>
					{articles.map((article) => {
						const localizedPost = article[lang] ?? article.fr ?? article.en!;
						const primaryLang = article[lang] ? lang : article.fr ? 'fr' : 'en';
						const otherPost = lang === 'fr' ? article.en : article.fr;
						return (
							<tr>
								<td>
									<a href={postUrl(primaryLang, article.slug)}>
										{localizedPost.data.heroImage && <Image width={720} height={360} src={localizedPost.data.heroImage} alt="" />}
									</a>
								</td>
								<td>
									<div class="languages">
										{article.fr ? <a class="language" href={postUrl('fr', article.slug)} aria-label={`${labels.openFrench} ${localizedPost.data.title}`}>FR</a> : <span class="language missing" title={labels.missingFrench}>FR</span>}
										{article.en ? <a class="language" href={postUrl('en', article.slug)} aria-label={`${labels.openEnglish} ${localizedPost.data.title}`}>EN</a> : <span class="language missing" title={labels.missingEnglish}>EN</span>}
									</div>
								</td>
								<td>
									<a href={postUrl(primaryLang, article.slug)}><p class="title">{localizedPost.data.title}</p></a>
									{otherPost && otherPost.data.title !== localizedPost.data.title && <span class="translation-title">{otherPost.data.title}</span>}
									<span class="slug">/{article.slug}/</span>
								</td>
								<td><p class="status">{getStatus(localizedPost)}</p></td>
								<td><p class="date"><FormattedDateArray date={localizedPost.data.startDate} locale={locale} /></p></td>
								<td><p class="date"><FormattedDateArray date={localizedPost.data.pubDate} locale={locale} /></p></td>
								<td><p class="date"><FormattedDateArray date={localizedPost.data.updatedDate} locale={locale} /></p></td>
							</tr>
						);
					})}
				</tbody>
			</table>
		</main>
		<Footer />
	</body>
</html>
