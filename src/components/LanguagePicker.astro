---
import { getLangFromUrl } from '../i18n/utils';

const currentLang = getLangFromUrl(Astro.url);
const siteBase = import.meta.env.BASE_URL.replace(/\/$/, '');
const targetLang = currentLang === 'fr' ? 'en' : 'fr';
const targetLabel = targetLang.toUpperCase();
const accessibleLabel = currentLang === 'fr' ? 'Switch to English' : 'Passer en français';
const pathnameWithoutBase = siteBase && Astro.url.pathname.startsWith(siteBase)
	? Astro.url.pathname.slice(siteBase.length)
	: Astro.url.pathname;
const pathSegments = pathnameWithoutBase.split('/').filter(Boolean);
const hasLocalizedPath = pathSegments[0] === 'fr' || pathSegments[0] === 'en';
if (hasLocalizedPath) pathSegments[0] = targetLang;
const targetPath = hasLocalizedPath ? `/${pathSegments.join('/')}${Astro.url.pathname.endsWith('/') ? '/' : ''}` : `/${targetLang}/`;
---

<a
	class="language-switch"
	href={`${siteBase}${targetPath}`}
	hreflang={targetLang}
	lang={targetLang}
	aria-label={accessibleLabel}
>
	{targetLabel}
</a>

<style>
	.language-switch {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 2.75rem;
		height: 2.75rem;
		padding: 0;
		box-sizing: border-box;
		border: 1px solid var(--header-sep);
		border-radius: 0.5rem;
		color: rgb(var(--gray));
		font-weight: 700;
		line-height: 1;
		text-decoration: none;
		transition: border-color 0.2s ease, color 0.2s ease, background-color 0.2s ease;
	}

	.language-switch:hover {
		border-color: rgb(var(--accent));
		color: rgb(var(--accent));
		background: rgba(var(--gray-light), 0.12);
	}
</style>
