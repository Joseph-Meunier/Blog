---
import { languages } from '../i18n/ui';
import { getLangFromUrl } from '../i18n/utils';

const currentLang = getLangFromUrl(Astro.url);
const siteBase = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<nav class="language-picker" aria-label="Language">
	{Object.entries(languages).map(([lang, label]) => (
		<a href={`${siteBase}/${lang}/`} lang={lang} aria-current={lang === currentLang ? 'page' : undefined}>
			{label}
		</a>
	))}
</nav>

<style>
	.language-picker { display: flex; gap: .5rem; }
	a { padding: .35rem .5rem; text-decoration: none; }
	a[aria-current='page'] { color: rgb(var(--accent)); font-weight: 700; }
</style>
