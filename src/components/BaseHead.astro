---
// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.
import type { ImageMetadata } from 'astro';
import { SEO } from 'astro-seo';
import FallbackImage from '../assets/global/fallbackImage.webp';
import { SITE_TITLE } from '../consts';
import '../styles/global.css';

interface Props {
	title: string;
	description: string;
	image?: ImageMetadata;
	pubDate?: Date;
	updatedDate?: Date;
	tags?: string[];
	locale?: string;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const {
	title,
	description,
	image = FallbackImage,
	pubDate,
	updatedDate,
	tags,
	locale = 'fr_FR',
} = Astro.props;
const imageURL = new URL(image.src, Astro.url).href;
const isArticle = Boolean(pubDate);
const assetBase = import.meta.env.BASE_URL.endsWith('/')
	? import.meta.env.BASE_URL
	: `${import.meta.env.BASE_URL}/`;
---

<SEO
	title={title}
	description={description}
	canonical={canonicalURL}
	charset="utf-8"
	robotsExtras="max-image-preview:large"
	openGraph={{
		basic: {
			title,
			type: isArticle ? 'article' : 'website',
			image: imageURL,
			url: canonicalURL,
		},
		optional: {
			description,
			locale,
			siteName: SITE_TITLE,
		},
		image: {
			alt: title,
		},
		...(isArticle && {
			article: {
				publishedTime: pubDate?.toISOString(),
				modifiedTime: updatedDate?.toISOString(),
				tags,
			},
		}),
	}}
	twitter={{
		card: 'summary_large_image',
		title,
		description,
		image: imageURL,
		imageAlt: title,
	}}
/>

<!-- Global Metadata -->
<meta name="viewport" content="width=device-width,initial-scale=1" />
<!-- Keep the site's own theme palette authoritative. Dark Reader otherwise
     recolors the light palette back to charcoal while our toggle still says light. -->
<meta name="darkreader-lock" />
<meta name="color-scheme" content="light dark" />

<!-- Script pour éviter le flash de contenu non stylisé (FOUC) - Inline direct -->
<script is:inline>
(function () {
	try {
		const storageKey = 'theme';
		const getPreferredTheme = () => {
			const stored = typeof localStorage !== 'undefined' ? localStorage.getItem(storageKey) : null;
			if (stored === 'light' || stored === 'dark') return stored;
			if (typeof window !== 'undefined' && window.matchMedia) {
				return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
			}
			return 'dark';
		};
		const theme = getPreferredTheme();
		document.documentElement.setAttribute('data-theme', theme);
	} catch (_) {
		document.documentElement.setAttribute('data-theme', 'dark');
	}
})();
</script>

<!-- Security Headers via Meta Tags -->
<meta http-equiv="Content-Security-Policy" content="default-src 'self'; script-src 'self' 'unsafe-inline' https://giscus.app; style-src 'self' 'unsafe-inline'; img-src 'self' https://avatars.githubusercontent.com https://github.githubassets.com; font-src 'self'; connect-src 'self' https://giscus.app; frame-src https://giscus.app; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" />
<meta http-equiv="X-Content-Type-Options" content="nosniff" />
<meta http-equiv="X-Frame-Options" content="DENY" />
<meta http-equiv="Referrer-Policy" content="strict-origin-when-cross-origin" />
<meta http-equiv="Permissions-Policy" content="camera=(), microphone=(), geolocation=()" />

<link rel="icon" type="image/svg+xml" href={`${assetBase}favicon.ico`} />
<link rel="sitemap" href={`${assetBase}sitemap-index.xml`} />
<link
	rel="alternate"
	type="application/rss+xml"
	title={SITE_TITLE}
	href={new URL('rss.xml', `${Astro.site}/`)}
/>
<meta name="generator" content={Astro.generator} />

<!-- Font preloads -->
<link rel="preload" href={`${assetBase}fonts/atkinson-regular.woff`} as="font" type="font/woff" crossorigin />
<link rel="preload" href={`${assetBase}fonts/atkinson-bold.woff`} as="font" type="font/woff" crossorigin />
