---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import type { GetStaticPaths, Page } from 'astro';
import BaseHead from '../../../components/BaseHead.astro';
import Footer from '../../../components/Footer.astro';
import FormattedDate from '../../../components/FormattedDate.astro';
import Header from '../../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../../consts';
import type { CollectionEntry } from 'astro:content';
import { languages, type Lang } from '../../../i18n/ui';
import { useTranslations } from '../../../i18n/utils';

export const getStaticPaths: GetStaticPaths = async ({ paginate }) => {
	const isProd = process.env.NODE_ENV === 'production';
	
	const allPosts = await getCollection('blog');
	return Object.keys(languages).flatMap((lang) => {
		const posts = allPosts
			.filter((post) => post.id.startsWith(`${lang}/`))
			.filter((post) => !isProd || (post.data.isPublished && post.data.pubDate <= new Date()))
			.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
		return paginate(posts, { params: { lang }, pageSize: 10 });
	});
};

type Props = {
	page: Page<CollectionEntry<'blog'>>;
};

const { page } = Astro.props;
const lang = Astro.params.lang as Lang;
const locale = lang === 'fr' ? 'fr-FR' : 'en-US';
const t = useTranslations(lang);
const isProd = process.env.NODE_ENV === 'production';
const siteBase = import.meta.env.BASE_URL.replace(/\/$/, '');

const postStatus = (post: CollectionEntry<'blog'>) => {
	return {
		status: post.data.isPublished && post.data.pubDate.valueOf() < Date.now() ? 'Publié' : 
		(post.data.isPublished && post.data.pubDate.valueOf() > Date.now() ? 'À venir' : 'Brouillon')
	};
};

---

<!doctype html>
<html lang={lang}>
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			main {
				width: 1080px;
				padding-top: 4rem;
			}
			section::before { content: '// ARCHIVES · KNOWLEDGE DATABASE'; display: block; margin-bottom: 2rem; color: var(--accent); font: 700 .78rem/1 monospace; letter-spacing: .18em; }
			ul {
				display: grid;
				grid-template-columns: repeat(2, minmax(0, 1fr));
				gap: 2rem;
				list-style-type: none;
				margin: 0;
				padding: 0;
			}
			ul li {
				width: auto;
				background: var(--color-surface);
				border: 1px solid var(--color-border);
				clip-path: polygon(0 0, calc(100% - 18px) 0, 100% 18px, 100% 100%, 0 100%);
			}
			ul li * {
				text-decoration: none;
				transition: 0.2s ease;
			}
			ul li img {
				display: block;
				width: 100%;
				aspect-ratio: 2 / 1;
				object-fit: cover;
				margin-bottom: 0;
				border-radius: 0;
				filter: saturate(.82) contrast(1.08);
			}
			ul li a {
				display: block;
				padding: .65rem;
			}
			.title {
				margin: 0;
				color: rgb(var(--black));
				line-height: 1;
				padding: .8rem .45rem .35rem;
			}
			.date {
				margin: 0;
				padding: 0 .45rem .7rem;
				color: rgb(var(--gray));
				font: .75rem/1.4 monospace;
				letter-spacing: .08em;
			}
			ul li a:hover h4,
			ul li a:hover .date {
				color: rgb(var(--accent));
			}
			ul a:hover img {
				box-shadow: 0 0 0 1px var(--accent), 0 0 28px rgba(0,234,255,.25);
			}
			ul li:hover { border-color: var(--accent); box-shadow: var(--neon-glow); }
			@media (max-width: 720px) {
				ul {
					grid-template-columns: 1fr;
					gap: 0.5em;
				}
				ul li {
					text-align: center;
				}
			}
			/* Ajoutez ces styles */
			.post-published {
				border: 2px solid green;
				border-radius: 12px;
				padding: 10px;
			}
			.post-upcoming {
				border: 2px solid orange;
				border-radius: 12px;
				padding: 10px;
			}
			.post-draft {
				border: 2px solid red;
				border-radius: 12px;
				padding: 10px;
			}
			/* Pagination styles */
			.pagination {
				display: flex;
				justify-content: center;
				gap: 1rem;
				margin-top: 3rem;
				align-items: center;
			}
			.pagination a,
			.pagination span {
				padding: 0.5rem 1rem;
				border-radius: 0;
				font: 700 .75rem/1 monospace;
				letter-spacing: .08em;
				text-decoration: none;
				transition: 0.2s ease;
			}
			.pagination a {
				background-color: rgba(0,234,255,.08);
				border: 1px solid var(--accent);
				color: var(--accent);
			}
			.pagination a:hover {
				background-color: var(--accent);
				color: #02050b;
			}
			.pagination a.disabled {
				background-color: rgb(var(--gray-light));
				color: rgb(var(--gray));
				pointer-events: none;
			}
			.pagination .current-page {
				color: rgb(var(--black));
				font-weight: bold;
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section>
				<ul>
					{
						page.data.map((post) => {
							const slug = post.id.split('/').slice(1).join('/');
							return (
							<li>
								<a href={`${siteBase}/${lang}/blog/${slug}/`}
								   class={!isProd ? (postStatus(post).status === 'Publié' ? 'post-published' : (postStatus(post).status === 'À venir' ? 'post-upcoming' : 'post-draft')) : ''}>
									{post.data.heroImage && (
										<Image width={720} height={360} src={post.data.heroImage} alt="" />
									)}
									<h4 class="title">{post.data.title}</h4>
									<p class="date">
										<FormattedDate date={post.data.pubDate} locale={locale} />
									</p>
								</a>
							</li>
							);
						})
					}
				</ul>
			</section>
			
			{/* Pagination controls */}
			<nav class="pagination">
				{page.url.prev ? (
					<a href={page.url.prev}>{t('blog.previous')}</a>
				) : (
					<a class="disabled">{t('blog.previous')}</a>
				)}
				
				<span class="current-page">
					{t('blog.page', { current: page.currentPage, total: page.lastPage })}
				</span>
				
				{page.url.next ? (
					<a href={page.url.next}>{t('blog.next')}</a>
				) : (
					<a class="disabled">{t('blog.next')}</a>
				)}
			</nav>
		</main>
		<Footer />
	</body>
</html>
