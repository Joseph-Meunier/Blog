---
const siteBase = import.meta.env.BASE_URL.replace(/\/$/, '');
const target = `${siteBase}/fr/status`;
---

<!doctype html>
<html lang="fr">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="robots" content="noindex" />
		<meta http-equiv="refresh" content={`0;url=${target}`} />
		<title>Redirection vers le statut</title>
		<script is:inline define:vars={{ target }}>window.location.replace(target);</script>
	</head>
	<body><a href={target}>Ouvrir la page statut</a></body>
</html>
